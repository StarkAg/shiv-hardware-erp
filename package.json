{
  "name": "shiv-panel",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Shiv Hardware Store — quotation, rate & guarantee-card panel with pixel-accurate A4 printing",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "desktop:dev": "npm run build && node electron/run-dev.cjs",
    "cloud:api": "npm --prefix cloud-api run dev",
    "convex:dev": "convex dev",
    "print:server": "node print-server/server.mjs",
    "shop": "concurrently -n panel,print -c cyan,yellow \"vite --host 0.0.0.0\" \"node print-server/server.mjs\"",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "convex": "^1.40.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.6",
    "@capacitor/cli": "^7.6.6",
    "@capacitor/core": "^7.6.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.47",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "in.shivhardware.panel",
    "productName": "Shiv Hardware Panel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "afterPack": "./electron/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "StarkAg",
        "repo": "shiv-panel-releases"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shiv-Hardware-Panel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
