ANTHROPIC_API_KEY=
PRINT_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
BW_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
COLOR_PRINTER=EPSON L8050 Series
# Printing engine. Printers listed here get the file drawn by the print server and sent
# straight over IPP (fastest, no driver); others print through tools/print-file.ps1
# (Windows' own PDF reader and printing, nothing to install). PRINT_ENGINE=sumatra goes back
# to SumatraPDF. IPP_PDF_DPI / IPP_PHOTO_DPI: drawing resolution (600 / 300).
PRINTER_IPP_URLS=
# PRINT_ENGINE=windows
# Files that print by themselves where they land (watch-print.mjs): "folder|name pattern|mode"
# rules split by ";", mode bw | color | auto; "off" for none. Default: SBI's PDFs in Downloads.
# AUTO_PRINT_WATCH=~/Downloads|SBIDocument_*.pdf|bw
# Bank prints (bank-print.mjs, docs/bank-printing.md): these names print on the printer chosen
# on the Counter's Printers screen (the Epson until one is chosen), black and white.
# BANK_PRINT_NAMES=SBIDocument_*.pdf
EPSON_DEFAULT_RESET_PLAIN_A4_COLOR=true
# Epson L8050 supports: Draft, Standard, HighQuality, AdvancedSetting. Standard is reliable on plain A4.
EPSON_A4_PRINT_QUALITY=Standard
BW_FALLBACK_PRINTER=EPSON L8050 Series
BW_FALLBACK_ON_ERROR=true
BW_FALLBACK_PRINT_SETTINGS=fit,monochrome,portrait,paper=A4,bin=Rear Paper Feeder
BW_FALLBACK_RESET_PLAIN_A4=true
# Optional public URL override. Leave blank to use the request host dynamically.
PRINT_SERVER_PUBLIC_URL=
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Use devmode on Windows after capturing Epson's private PVC ID-card settings.
EPSON_CARD_PRINT_SETTINGS=noscale,color,landscape
EPSON_CARD_PRINT_ENGINE=sumatra
EPSON_CARD_DEVMODE_PATH=
EPSON_CARD_OFFSET_X_MM=0
EPSON_CARD_OFFSET_Y_MM=0
EPSON_CARD_SCALE_PERCENT=100

# Optional cloud print polling. Enable these on the Windows shop print server.
CLOUD_API_URL=https://your-railway-cloud-api.up.railway.app
CLOUD_API_KEY=change-this-shared-secret
PRINTER_AGENT_ID=shiv-shop-printer
CLOUD_POLL_INTERVAL_MS=7000

# Optional WhatsApp Web auto-print. When enabled, scan the QR at /whatsapp-web.
WHATSAPP_AUTO_PRINT_ENABLED=false
WHATSAPP_AUTO_PRINT_GROUP_NAME=Shiv Hardware
WHATSAPP_AUTO_PRINT_GROUP_ID=
WHATSAPP_AUTO_PRINT_COPIES=1
WHATSAPP_AUTO_PRINT_COMMAND_TTL_MS=600000
WHATSAPP_AUTO_PRINT_POLL_INTERVAL_MS=5000
WHATSAPP_AUTO_PRINT_MEDIA_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# Folder where every WhatsApp media file is downloaded before being queued to print.
# Defaults to <user home>/Downloads/whatsapp Prints
# WHATSAPP_PRINTS_DIR=
# Print images straight to the printer (scaled via "fit") instead of wrapping them
# in an A4 PDF with Chrome first. Faster, but caused blank pages on the Epson L8050,
# so keep false (reliable Chrome wrapping). Set to true only if your printer prints fine.
WHATSAPP_IMAGE_DIRECT_PRINT=false
WHATSAPP_COLOR_PRINT_SETTINGS=fit,color,portrait,paper=A4,bin=Rear Paper Feeder
WHATSAPP_BW_PRINT_SETTINGS=fit,monochrome,portrait,paper=A4
BILL_PRINT_SETTINGS=print-quality=5
QUOTATION_PRINT_SETTINGS=fit,color,portrait,paper=A4,bin=Rear Paper Feeder,print-quality=5
WHATSAPP_WEB_CLIENT_ID=shiv-print-server

# Optional: message the customer from the same WhatsApp account when their
# guarantee card is generated/printed. Deduped per card number so reprints
# (and the A4 + PVC-card passes for one card) never double-send.
# Defaults to WHATSAPP_AUTO_PRINT_ENABLED when unset.
WHATSAPP_CUSTOMER_NOTIFY_ENABLED=true
# Country code prepended to bare 10-digit local mobiles (India = 91).
WHATSAPP_CUSTOMER_COUNTRY_CODE=91
# {name} is replaced with the customer's name; \n becomes a line break.
WHATSAPP_GUARANTEE_MESSAGE=Hi {name} 👋\n\nThank you for purchasing with us. Your guarantee card 💳 is processed — please collect it from the shop.
# Don't message the same customer twice within this window (ms). Covers the
# Generate button + Print auto-notify + double-clicks. 0 disables. Default 10 min.
WHATSAPP_NOTIFY_COOLDOWN_MS=600000

# Auto-reply to anyone who DMs the shop WhatsApp account (groups are unaffected).
WHATSAPP_AUTOREPLY_ENABLED=true
WHATSAPP_AUTOREPLY_MESSAGE=For any enquiries contact 8092850954 on WhatsApp.
# Don't auto-reply to the same person again within this window (ms). Default 1 hour.
WHATSAPP_AUTOREPLY_COOLDOWN_MS=3600000

# Base URL the printed guarantee-card QR points to (the online card view). Set to
# your public Vercel viewer so a customer's scan works off the shop Wi-Fi, e.g.
# GUARANTEE_PUBLIC_URL=https://your-viewer.vercel.app
# Leave blank to use the shop LAN address (only works on the shop Wi-Fi).
GUARANTEE_PUBLIC_URL=

# "order" on WhatsApp (any chat, anyone) -> read the handwritten bill photo and
# reply with the plywood/steel/telescopic item list. Mesh API (OpenAI-compatible).
WHATSAPP_ORDER_OCR_ENABLED=true
MESH_API_KEY=
MESH_API_BASE_URL=https://api.meshapi.ai/v1
MESH_OCR_MODEL=google/gemini-2.5-flash
