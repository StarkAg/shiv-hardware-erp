ANTHROPIC_API_KEY=
PRINT_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
BW_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
COLOR_PRINTER=EPSON L8050 Series
EPSON_DEFAULT_RESET_PLAIN_A4_COLOR=true
EPSON_A4_PRINT_QUALITY=High
BW_FALLBACK_PRINTER=EPSON L8050 Series
BW_FALLBACK_ON_ERROR=true
BW_FALLBACK_PRINT_SETTINGS=fit,monochrome,portrait,paper=A4,bin=Rear Paper Feeder
BW_FALLBACK_RESET_PLAIN_A4=true
# Optional public URL override. Leave blank to use the request host dynamically.
PRINT_SERVER_PUBLIC_URL=
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Use devmode on Windows after capturing Epson's private PVC ID-card settings.
EPSON_CARD_PRINT_SETTINGS=noscale,color,landscape
EPSON_CARD_PRINT_ENGINE=sumatra
EPSON_CARD_DEVMODE_PATH=
EPSON_CARD_OFFSET_X_MM=0
EPSON_CARD_OFFSET_Y_MM=0
EPSON_CARD_SCALE_PERCENT=100

# Optional cloud print polling. Enable these on the Windows shop print server.
CLOUD_API_URL=https://your-railway-cloud-api.up.railway.app
CLOUD_API_KEY=change-this-shared-secret
PRINTER_AGENT_ID=shiv-shop-printer
CLOUD_POLL_INTERVAL_MS=7000

# Optional WhatsApp Web auto-print. When enabled, scan the QR at /whatsapp-web.
WHATSAPP_AUTO_PRINT_ENABLED=false
WHATSAPP_AUTO_PRINT_GROUP_NAME=Shiv Hardware
WHATSAPP_AUTO_PRINT_GROUP_ID=
WHATSAPP_AUTO_PRINT_COPIES=1
WHATSAPP_AUTO_PRINT_COMMAND_TTL_MS=600000
WHATSAPP_AUTO_PRINT_POLL_INTERVAL_MS=5000
WHATSAPP_AUTO_PRINT_MEDIA_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# Folder where every WhatsApp media file is downloaded before being queued to print.
# Defaults to <user home>/Downloads/whatsapp Prints
# WHATSAPP_PRINTS_DIR=
# Print images straight to the printer (scaled via "fit") instead of wrapping them
# in an A4 PDF with Chrome first. Much faster. Set to false to restore Chrome wrapping.
WHATSAPP_IMAGE_DIRECT_PRINT=true
WHATSAPP_COLOR_PRINT_SETTINGS=fit,color,portrait,paper=A4,bin=Rear Paper Feeder
WHATSAPP_BW_PRINT_SETTINGS=fit,monochrome,portrait,paper=A4
BILL_PRINT_SETTINGS=print-quality=5
QUOTATION_PRINT_SETTINGS=fit,color,portrait,paper=A4,bin=Rear Paper Feeder,print-quality=5
WHATSAPP_WEB_CLIENT_ID=shiv-print-server
