ANTHROPIC_API_KEY=
PRINT_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
BW_PRINTER=HP_Ink_Tank_Wireless_410_series__83E60C_
COLOR_PRINTER=EPSON L8050 Series
# Optional public URL override. Leave blank to use the request host dynamically.
PRINT_SERVER_PUBLIC_URL=
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Use devmode on Windows after capturing Epson's private PVC ID-card settings.
EPSON_CARD_PRINT_SETTINGS=noscale,color,landscape
EPSON_CARD_PRINT_ENGINE=sumatra
EPSON_CARD_DEVMODE_PATH=
EPSON_CARD_OFFSET_X_MM=0
EPSON_CARD_OFFSET_Y_MM=0
EPSON_CARD_SCALE_PERCENT=100

# Optional cloud print polling. Enable these on the Windows shop print server.
CLOUD_API_URL=https://your-railway-cloud-api.up.railway.app
CLOUD_API_KEY=change-this-shared-secret
PRINTER_AGENT_ID=shiv-shop-printer
CLOUD_POLL_INTERVAL_MS=7000
